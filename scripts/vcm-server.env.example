# scripts/vcm-server.env.example — environment file template.
#
# The real env file lives at ~/.vcm/server.env and is created from this
# template by `scripts/install-service.sh` on first install. It is
# chmod 600 (server address + DB path are sensitive).
#
# All variables are optional — defaults shown match the Flask app's own
# fallbacks (server/app.py). Remove the leading '#' to override.

# Port to bind. Default 7338. The install script auto-detects a free
# port in 7338..7399 and rewrites the value here.
#VCM_SERVER_PORT=7338

# SQLite database path. Defaults to <repo>/server/vcm.db. Keep this
# on disk the user can read (the unit runs with ProtectHome=read-only
# so the only writable root paths it can reach via symlink are /home
# and /tmp).
#VCM_SERVER_DB=/home/your-user/vcm/server/vcm.db

# JSONL audit log path. Same place by default; vcm-server writes
# JSONL alongside the SQLite entries (ADR-0009 + ADR-0012).
#VCM_AUDIT_LOG=/home/your-user/.vcm/audit.log

# Optional: enable BasicAuth (ADR-0004). When set, the gate applies
# to ALL /api/* routes except /api/health. CHARTER §6 says every
# write must be auditable, so production should set these.
#VCM_AUTH_USER=
#VCM_AUTH_PASS=

# Optional: skip audit log entirely. CHARTER §6: NEVER set this in
# production; it's for development when the JSONL is noisy.
#VCM_AUDIT_DISABLED=0

# Optional: peers (ADR-0022). Path to a JSON file listing peer URLs.
# Default ~/.vcm/peers.json.
#VCM_PEERS=

# Optional: enable pip-level shell completion? Not used by the
# server today; reserved for future versions.
#VCM_REGISTRY_DIR=
